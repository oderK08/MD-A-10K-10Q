# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts
*.egg-info/
.eggs/
build/
dist/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Editor / OS
.vscode/
.idea/
.DS_Store

# External data files (third-party license, e.g. the Loughran-McDonald
# Master Dictionary) -- see data/README.md for where to get them.
data/*
!data/README.md
