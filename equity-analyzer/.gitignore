# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts
*.egg-info/
.eggs/
build/
dist/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Editor / OS
.vscode/
.idea/
.DS_Store

# External data files -- see data/README.md. The Loughran-McDonald Master
# Dictionary is tracked (below) since it's committed for convenience;
# anything else dropped in data/ stays untracked by default.
data/*
!data/README.md
!data/Loughran-McDonald_MasterDictionary_1993-2025.csv

# Transcripts mis en cache par scripts/latest_call.py. Un transcript
# passé ne change jamais, donc le cache évite de redépenser le quota.
# Décommenter pour les committer et les partager entre exécutions.
#transcripts/
dernier_call.md
