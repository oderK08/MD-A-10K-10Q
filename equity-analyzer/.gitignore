# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts
*.egg-info/
.eggs/
build/
dist/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Editor / OS
.vscode/
.idea/
.DS_Store

# External data files -- see data/README.md. The Loughran-McDonald Master
# Dictionary is tracked (below) since it's committed for convenience;
# anything else dropped in data/ stays untracked by default.
data/*
!data/README.md
!data/Loughran-McDonald_MasterDictionary_1993-2025.csv

# Transcripts. VOLONTAIREMENT SUIVIS PAR GIT, ne pas ignorer. Un
# transcript passé ne change jamais, donc un fichier committé ici est lu
# avant tout appel au fournisseur et ne coûte aucun quota. C'est aussi
# par là qu'entre un transcript que tu as produit toi même quand le
# fournisseur n'a pas le call (voir scripts/importer_transcript.py), et
# ce qui permet à un lecteur d'ouvrir le texte pour vérifier une
# citation du rapport.

# PDF générés. Le rapport se regénère à la demande, et un PDF committé
# est surtout un moyen de croire qu'on regarde le dernier trimestre.
rapports/

# Historique produit par les runs : vit sur la branche `donnees`,
# jamais sur `main`. Ignoré ici pour qu'un run local ne salisse pas
# l'arbre de travail.
historique/
